@model Project_CakeShop_66095681.Models.Db.Product

@{
    ViewData["Title"] = "แก้ไขสินค้า";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap');

    * { box-sizing: border-box; }

    body {
        background: #f0f2f8;
        font-family: 'Kanit', sans-serif;
        min-height: 100vh;
    }

    .page-wrap {
        max-width: 780px;
        margin: 40px auto;
        padding: 0 20px 60px;
    }

    /* Back */
    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #888;
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        transition: color 0.2s;
        margin-bottom: 24px;
    }
    .btn-back:hover { color: #333; }

    /* Card */
    .form-card {
        background: #fff;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0,0,0,0.07);
    }

    /* Header */
    .card-header-area {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);
        padding: 32px 36px;
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .header-icon {
        width: 48px;
        height: 48px;
        background: rgba(255,255,255,0.12);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
    }
    .card-header-area h2 {
        color: #fff;
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        letter-spacing: -0.3px;
    }
    .card-header-area p {
        color: rgba(255,255,255,0.55);
        font-size: 0.82rem;
        margin: 2px 0 0;
    }

    /* Body */
    .card-body-area {
        padding: 36px;
    }

    /* Section title */
    .section-title {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #aaa;
        margin: 28px 0 14px;
    }
    .section-title:first-child { margin-top: 0; }

    /* Input */
    .field-group { margin-bottom: 18px; }
    .field-label {
        display: block;
        font-size: 0.83rem;
        font-weight: 600;
        color: #444;
        margin-bottom: 7px;
    }
    .field-input {
        width: 100%;
        border: 1.5px solid #e8e8e8;
        border-radius: 12px;
        padding: 11px 15px;
        font-family: 'Kanit', sans-serif;
        font-size: 0.92rem;
        color: #222;
        background: #fafafa;
        transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        outline: none;
    }
    .field-input:focus {
        border-color: #0f3460;
        background: #fff;
        box-shadow: 0 0 0 3px rgba(15,52,96,0.08);
    }

    /* Row grid */
    .row-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    /* Image section */
    .image-section {
        background: #f8f9fc;
        border-radius: 16px;
        padding: 20px;
        border: 1.5px dashed #dde0ec;
    }
    .current-image-wrap {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 16px;
    }
    .current-img {
        width: 80px;
        height: 80px;
        border-radius: 12px;
        object-fit: cover;
        border: 2px solid #e0e0e0;
        flex-shrink: 0;
    }
    .img-label-wrap small {
        display: block;
        font-size: 0.75rem;
        color: #999;
        margin-top: 3px;
    }
    .img-label-wrap strong {
        font-size: 0.85rem;
        color: #333;
    }
    .file-input-wrap {
        position: relative;
    }
    .file-input-wrap input[type="file"] {
        width: 100%;
        border: 1.5px solid #e8e8e8;
        border-radius: 10px;
        padding: 10px 14px;
        font-family: 'Kanit', sans-serif;
        font-size: 0.85rem;
        background: #fff;
        cursor: pointer;
    }
    .file-hint {
        font-size: 0.75rem;
        color: #aaa;
        margin-top: 6px;
    }

    /* Divider */
    .divider { border: none; border-top: 1.5px solid #f0f0f0; margin: 28px 0; }

    /* Buttons */
    .btn-row {
        display: flex;
        gap: 12px;
        margin-top: 28px;
    }
    .btn-save {
        flex: 1;
        background: linear-gradient(135deg, #1a1a2e, #0f3460);
        color: #fff;
        border: none;
        border-radius: 14px;
        padding: 13px 24px;
        font-family: 'Kanit', sans-serif;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.15s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }
    .btn-save:hover { opacity: 0.88; transform: translateY(-1px); }
    .btn-cancel {
        padding: 13px 22px;
        border: 1.5px solid #e0e0e0;
        border-radius: 14px;
        background: #fff;
        color: #666;
        font-family: 'Kanit', sans-serif;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s, color 0.2s;
    }
    .btn-cancel:hover { background: #f5f5f5; color: #333; }
</style>

<div class="page-wrap">
    <a asp-action="ManageProduct" class="btn-back">
        ← กลับ
    </a>

    <div class="form-card">
        <div class="card-header-area">
            <div class="header-icon">🎂</div>
            <div>
                <h2>แก้ไขข้อมูลสินค้า</h2>
                <p>อัปเดตรายละเอียดของสินค้าเค้กในร้าน</p>
            </div>
        </div>

        <div class="card-body-area">
            <form asp-action="EditProduct" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="ProductId" />

                <p class="section-title">ข้อมูลสินค้า</p>

                <div class="field-group">
                    <label class="field-label">ชื่อสินค้า</label>
                    <input asp-for="CakeName" class="field-input" placeholder="เช่น เค้กช็อกโกแลตเข้ม" required />
                </div>

                <div class="row-2">
                    <div class="field-group">
                        <label class="field-label">ราคา (฿)</label>
                        <input asp-for="Price" type="number" step="0.01" class="field-input" placeholder="0.00" required />
                    </div>
                    <div class="field-group">
                        <label class="field-label">จำนวนสต็อก</label>
                        <input asp-for="StockQty" type="number" class="field-input" placeholder="0" required />
                    </div>
                </div>

                <div class="field-group">
                    <label class="field-label">ส่วนลด (฿)</label>
                    <input asp-for="DiscountAmount" type="number" step="0.1" class="field-input" placeholder="0" />
                </div>

                <hr class="divider" />

                <p class="section-title">รูปภาพสินค้า</p>

                <div class="image-section">
                    @if (!string.IsNullOrEmpty(Model.ProductImage))
                    {
                        <div class="current-image-wrap">
                            <img src="@Model.ProductImage" class="current-img" alt="รูปสินค้าปัจจุบัน" />
                            <div class="img-label-wrap">
                                <strong>รูปภาพปัจจุบัน</strong>
                                <small>หากไม่เลือกรูปใหม่ ระบบจะใช้รูปนี้ต่อไป</small>
                            </div>
                        </div>
                    }
                    <div class="file-input-wrap">
                        <label class="field-label">เปลี่ยนรูปภาพ</label>
                        <input type="file" name="imageFile" accept="image/*" />
                        <p class="file-hint">รองรับไฟล์ .jpg, .png, .webp — ขนาดไม่เกิน 5MB</p>
                    </div>
                </div>

                <div class="btn-row">
                    <a asp-action="ManageProduct" class="btn-cancel">ยกเลิก</a>
                    <button type="submit" class="btn-save">💾 บันทึกการเปลี่ยนแปลง</button>
                </div>
            </form>
        </div>
    </div>
</div>
