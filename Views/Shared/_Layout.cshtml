<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CakeShop</title>
    
    @* --- CSS & Fonts --- *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Kanit:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --primary-dark: #1a1a1a;
            --accent-green: #198754;
            --border-color: #eee;
            --nav-height: 76px;
        }

        body {
            font-family: 'Kanit', sans-serif;
            background-color: #fcfcfc;
            color: var(--primary-dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            padding-top: var(--nav-height); /* ✅ จะถูก override ด้านล่างถ้าเป็น Admin/Staff */
        }

        .navbar {
            background-color: rgba(255, 255, 255, 0.98) !important;
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border-color);
            padding: 12px 0;
            z-index: 1050;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.4rem;
            color: var(--primary-dark) !important;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand-icon { color: var(--accent-green); font-size: 1.8rem; }
        
        .nav-link { 
            font-weight: 500; 
            font-size: 0.95rem; 
            color: #555 !important; 
            transition: 0.2s; 
            padding: 0.5rem 1rem !important;
        }
        
        .nav-link:hover, .nav-link.active { color: var(--accent-green) !important; }

        .user-dropdown-btn {
            background: #f8f9fa;
            border-radius: 50px;
            padding: 6px 16px;
            border: 1px solid #eee;
            font-weight: 600;
            transition: 0.3s;
        }

        .user-dropdown-btn:hover { background: #f1f1f1; }

        .role-badge {
            font-size: 0.65rem;
            padding: 2px 10px;
            border-radius: 50px;
            text-transform: uppercase;
            font-weight: 700;
            margin-left: 5px;
        }
        .admin-badge { background: #fff4e6; color: #fd7e14; border: 1px solid #ffe8cc; }
        .staff-badge { background: #e6fcf5; color: #087f5b; border: 1px solid #c3fae8; }

        .btn-login-nav {
            border-radius: 50px;
            padding: 8px 24px;
            font-weight: 600;
            border: 2px solid var(--primary-dark);
            transition: 0.3s;
        }

        .btn-login-nav:hover { background: var(--primary-dark); color: #fff !important; }

        main { flex: 1; }
    </style>
</head>
<body>
    @using Microsoft.AspNetCore.Http
    @using System.Text.Json
    @inject IHttpContextAccessor HttpContextAccessor
    @{
        var session = HttpContextAccessor.HttpContext.Session;
        var userName = session.GetString("UserName");
        var userRole = session.GetString("UserRole");
        
        // Cart Logic
        var cartCount = 0;
        var cartJson = session.GetString("Cart");
        if (!string.IsNullOrEmpty(cartJson)) {
            try {
                var cart = JsonSerializer.Deserialize<List<Project_CakeShop_66095681.Models.CartItem>>(cartJson);
                cartCount = cart?.Sum(x => x.Quantity) ?? 0;
            } catch { }
        }

        // Home Redirection Logic
        string hController = (userRole == "Admin") ? "Admin" : (userRole == "Staff") ? "Staff" : "Home";
        string hAction = (userRole == "Admin" || userRole == "Staff") ? "Dashboard" : "Welcome";

        // ✅ ตรวจว่าเป็นหน้า Admin หรือ Staff → ซ่อน Navbar + Footer + padding
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
        var hideNav = (currentController == "Admin" || currentController == "Staff");
    }

    @* ✅ ถ้าเป็น Admin/Staff ให้ลบ padding-top ออก *@
    @if (hideNav)
    {
        <style> body { padding-top: 0 !important; } </style>
    }

    @* ✅ แสดง Navbar เฉพาะหน้า Customer เท่านั้น *@
    @if (!hideNav)
    {
        <header>
            <nav class="navbar navbar-expand-lg fixed-top shadow-sm">
                <div class="container">
                    <a class="navbar-brand" asp-controller="@hController" asp-action="@hAction">
                        <i class="bi bi-cake2-fill brand-icon"></i>
                        <span>CAKESHOP<span class="text-success">.</span></span>
                    </a>

                    <button class="navbar-toggler border-0 shadow-none" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                        <i class="bi bi-list fs-1"></i>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav mx-auto">
                            @if (userRole == "Admin" && currentController == "Admin")
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-graph-up me-1"></i>ภาพรวม</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="ManageProduct"><i class="bi bi-box-seam me-1"></i>สินค้า</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="ManageUsers"><i class="bi bi-people me-1"></i>สมาชิก</a></li>
                            }
                            else if (userRole == "Staff" && currentController == "Staff")
                            {
                                <li class="nav-item"><a class="nav-link text-success fw-bold" asp-controller="Staff" asp-action="Dashboard"><i class="bi bi-pc-display-horizontal me-1"></i>ระบบขาย (POS)</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Staff" asp-action="ManageOrders"><i class="bi bi-receipt me-1"></i>ออเดอร์</a></li>
                            }
                            else
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Welcome">หน้าหลัก</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="User" asp-action="ProductCustomer">เลือกซื้อเค้ก</a></li>
                                @if (userRole == "Admin" || userRole == "Staff")
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-primary fw-bold" asp-controller="@userRole" asp-action="Dashboard">
                                            <i class="bi bi-arrow-left-circle me-1"></i>กลับเข้าระบบ @userRole
                                        </a>
                                    </li>
                                }
                            }
                        </ul>

                        <div class="d-flex align-items-center gap-2">
                            @if (userRole != "Admin" && userRole != "Staff")
                            {
                                <a asp-controller="User" asp-action="Cart" class="nav-link position-relative p-2 me-2">
                                    <i class="bi bi-bag-heart fs-4 text-dark"></i>
                                    @if (cartCount > 0) {
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-white" style="font-size: 0.6rem;">@cartCount</span>
                                    }
                                </a>
                            }

                            @if (!string.IsNullOrEmpty(userName))
                            {
                                <div class="dropdown">
                                    <a class="dropdown-toggle user-dropdown-btn d-flex align-items-center text-decoration-none text-dark" href="#" data-bs-toggle="dropdown">
                                        <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 30px; height: 30px; font-size: 0.85rem;">
                                            @userName.Substring(0,1).ToUpper()
                                        </div>
                                        <span class="me-1">@userName</span>
                                        @if(userRole == "Admin"){ <span class="role-badge admin-badge">Admin</span> }
                                        @if(userRole == "Staff"){ <span class="role-badge staff-badge">Staff</span> }
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg mt-3 p-2" style="border-radius: 12px; min-width: 210px;">
                                        <li><h6 class="dropdown-header text-uppercase small text-muted">เมนูส่วนตัว</h6></li>
                                        <li><a class="dropdown-item rounded-3 py-2" asp-controller="User" asp-action="Profile"><i class="bi bi-person-circle me-2"></i>โปรไฟล์</a></li>
                                        @if(userRole == "Customer"){
                                            <li><a class="dropdown-item rounded-3 py-2" asp-controller="User" asp-action="OrderHistory"><i class="bi bi-clock-history me-2"></i>ประวัติสั่งซื้อ</a></li>
                                        }
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item rounded-3 py-2 text-danger fw-bold" asp-controller="User" asp-action="Logout">
                                                <i class="bi bi-box-arrow-right me-2"></i>ออกจากระบบ
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <a class="btn btn-login-nav text-dark" asp-controller="User" asp-action="Login">
                                    <i class="bi bi-person-fill me-1"></i> เข้าสู่ระบบ
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    }

    <main role="main" class="@(!hideNav ? "container animate__animated animate__fadeIn" : "")">
        @RenderBody()
    </main>

    @* ✅ ซ่อน Footer ในหน้า Admin และ Staff ด้วย *@
    @if (!hideNav)
    {
        <footer class="footer mt-auto py-4 bg-white border-top">
            <div class="container text-center">
                <span class="text-muted small">&copy; 2026 CAKESHOP - ให้ทุกวันของคุณเป็นวันหวานๆ 🍰</span>
            </div>
        </footer>
    }

    @* --- Scripts --- *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
