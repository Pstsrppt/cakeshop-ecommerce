@using Project_CakeShop_66095681.Models.Db
@model IEnumerable<Product>

@{
    ViewData["Title"] = "Our Fresh Bakery";
}

<style>
    /* 1. Global & Theme Colors */
    :root {
        --bakery-green: #198754;
        --bakery-dark: #1a1a1a;
        --bakery-light-bg: #f8fdfa;
    }

    body {
        background-color: #ffffff;
        font-family: 'Kanit', sans-serif;
        color: #333;
    }

    /* 2. Shop Header */
    .shop-banner {
        background: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.2)), url('https://images.unsplash.com/photo-1517433670267-08bbd4be890f?auto=format&fit=crop&q=80&w=1200');
        background-size: cover;
        background-position: center;
        height: 350px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        border-radius: 0 0 60px 60px;
        margin-bottom: 60px;
        text-align: center;
    }

    .shop-banner h1 {
        font-size: 4rem;
        font-weight: 800;
        letter-spacing: -1px;
    }

    /* 3. Info Bar */
    .info-bar {
        background: var(--bakery-light-bg);
        border-radius: 20px;
        padding: 15px 25px;
        margin-top: -90px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(25, 135, 84, 0.1);
        z-index: 10;
        position: relative;
    }

    /* 4. Product Card & Image Locking */
    .product-card {
        background: #fff;
        border: 1px solid #f0f0f0;
        border-radius: 24px;
        overflow: hidden;
        transition: all 0.4s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
        border-color: var(--bakery-green);
    }

    /* หัวใจสำคัญ: ล็อคขนาดรูปเป็น 1:1 */
    .image-wrapper {
        position: relative;
        width: 100%;
        padding-top: 100%; /* ล็อคสัดส่วนจตุรัส */
        overflow: hidden;
        background: #f9f9f9;
    }

    .product-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover; /* ครอปรูปให้พอดีไม่ว่าจะมาไซส์ไหน */
        transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .product-card:hover .product-img {
        transform: scale(1.1);
    }

    .badge-discount {
        position: absolute;
        top: 15px;
        left: 15px;
        background: #dc3545;
        color: white;
        padding: 4px 12px;
        border-radius: 50px;
        font-size: 0.7rem;
        font-weight: 700;
        z-index: 2;
        text-transform: uppercase;
    }

    /* 5. Product Details Management */
    .product-body {
        padding: 20px;
        text-align: center;
        display: flex;
        flex-direction: column;
        flex-grow: 1; /* ดันเนื้อหาให้ยืดเท่ากัน */
    }

    .product-title {
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--bakery-dark);
        margin-bottom: 8px;
        line-height: 1.4;
        /* ล็อคความสูงชื่อสินค้าไม่เกิน 2 บรรทัด */
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 3rem; 
    }

    .price-tag {
        font-size: 1.2rem;
        font-weight: 800;
        color: var(--bakery-green);
    }

    .old-price {
        text-decoration: line-through;
        color: #bbb;
        font-size: 0.85rem;
        margin-right: 6px;
    }

    .btn-buy-now {
        border: 1.8px solid var(--bakery-dark);
        border-radius: 50px;
        padding: 10px 20px;
        font-weight: 700;
        background: #fff;
        color: var(--bakery-dark);
        text-decoration: none;
        display: inline-block;
        width: 100%;
        transition: 0.3s;
        font-size: 0.8rem;
        text-transform: uppercase;
    }

    .btn-buy-now:hover {
        background: var(--bakery-dark);
        color: #fff;
    }

    .out-of-stock {
        filter: grayscale(0.8);
        opacity: 0.7;
    }

    .out-of-stock-btn {
        background: #eee !important;
        border-color: #eee !important;
        color: #888 !important;
        cursor: not-allowed;
    }
</style>

@* Banner Section *@
<div class="shop-banner">
    <div class="container">
        <h1 class="animate__animated animate__fadeInDown">All Cakes<span>.</span></h1>
        <p class="text-white-50">เลือกซื้อเค้กโฮมเมดที่อบสดใหม่จากเตาทุกวัน</p>
    </div>
</div>

<div class="container">
    @* Info Bar *@
    <div class="info-bar d-flex justify-content-between align-items-center mb-5">
        <div class="fw-bold">
            <i class="bi bi-grid-3x3-gap-fill text-success me-2"></i>
            สินค้าทั้งหมด <span class="badge bg-success rounded-pill ms-1">@Model.Count()</span>
        </div>
        <div class="text-muted small d-none d-md-block">
            <i class="bi bi-info-circle me-1"></i> คลิกที่สินค้าเพื่อดูรายละเอียดเพิ่มเติม
        </div>
    </div>

    @* Product Grid *@
    <div class="row g-4 mb-5">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-6 col-md-4 col-lg-3 animate__animated animate__fadeInUp">
                    <div class="product-card @(item.StockQty <= 0 ? "out-of-stock" : "")">
                        @* ส่วนรูปภาพที่ถูกล็อคขนาด (คลิกเข้าหน้ารายละเอียด) *@
                        <a asp-action="ProductDetail" asp-route-id="@item.ProductId" class="text-decoration-none">
                            <div class="image-wrapper">
                                @if (item.DiscountAmount > 0)
                                {
                                    <span class="badge-discount">Special Offer</span>
                                }
                                <img src="@(string.IsNullOrEmpty(item.ProductImage) ? "/images/no-image.jpg" : item.ProductImage)"
                                     class="product-img" alt="@item.CakeName" />
                            </div>
                        </a>

                        @* ส่วนเนื้อหา *@
                        <div class="product-body">
                            <a asp-action="ProductDetail" asp-route-id="@item.ProductId" class="text-decoration-none">
                                <div class="product-title">@item.CakeName</div>
                            </a>

                            <div class="price-section mb-3">
                                @if (item.DiscountAmount > 0)
                                {
                                    <span class="old-price">฿@item.Price.ToString("N0")</span>
                                    <span class="price-tag">฿@((item.Price - item.DiscountAmount.Value).ToString("N0"))</span>
                                }
                                else
                                {
                                    <span class="price-tag">฿@item.Price.ToString("N0")</span>
                                }
                            </div>

                            @* ปุ่มจะถูกดันลงมาล่างสุดเสมอด้วย mt-auto *@
                            <div class="mt-auto">
                                @if (item.StockQty > 0)
                                {
                                    <form asp-action="AddToCart" method="post">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" class="btn-buy-now">
                                            <i class="bi bi-cart-plus me-1"></i> Add to Cart
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn-buy-now out-of-stock-btn" disabled>
                                        Sold Out
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-search fs-1 text-muted d-block mb-3"></i>
                <h5>ไม่พบรายการสินค้า</h5>
                <p class="text-muted">ขออภัย ขณะนี้ยังไม่มีสินค้าในหมวดหมู่ที่ท่านเลือก</p>
                <a href="/" class="btn btn-dark rounded-pill px-4 mt-2">กลับไปหน้าแรก</a>
            </div>
        }
    </div>
</div>

@* Footer Space *@
<div class="py-5"></div>