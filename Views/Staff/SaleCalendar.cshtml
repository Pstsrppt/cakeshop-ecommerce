@{
    ViewData["Title"] = "ปฏิทินยอดขาย";
}

<div class="container-fluid p-4">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-4"><i class="bi bi-calendar3 me-2"></i>ปฏิทินสรุปยอดขาย</h4>
            <div id='calendar'></div>
        </div>
    </div>
</div>

<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js'></script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var calendarEl = document.getElementById('calendar');
    var calendar = new FullCalendar.Calendar(calendarEl, {
      initialView: 'dayGridMonth',
      locale: 'th',
      buttonText: { today: 'วันนี้' },
      // ดึงข้อมูลจาก Action ที่เราเพิ่งแก้ไปด้านบน
      events: '/Staff/GetSalesForCalendar', 
      eventDisplay: 'block',
      eventTextColor: '#ffffff'
    });
    calendar.render();
  });
</script>

<style>
    /* ปรับแต่งความสวยงามของปฏิทิน */
    .fc-event { cursor: pointer; padding: 2px 5px; border-radius: 5px; border: none; }
    .fc-toolbar-title { font-weight: bold; color: #6366f1; }
    .fc-daygrid-day-number { text-decoration: none; color: #64748b; }
</style>