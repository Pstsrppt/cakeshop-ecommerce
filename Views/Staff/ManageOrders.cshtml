@model IEnumerable<Project_CakeShop_66095681.Models.Db.Order>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ประวัติการขาย - Cake Shop</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
            body {
                font-family: 'Sarabun', sans-serif;
                background-color: #f8fafc;
                color: #1e293b;
            }

            .main-container {
                max-width: 1100px;
                margin: 0 auto;
            }

            /* ปรับปรุง Card สรุปยอดขายให้คลีนที่สุด */
            .summary-card-custom {
                background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
                border-radius: 20px;
                border: none;
                overflow: hidden;
                box-shadow: 0 10px 20px -5px rgba(99, 102, 241, 0.4);
            }

            .icon-box {
                width: 56px;
                height: 56px;
                background: rgba(255, 255, 255, 0.2);
                backdrop-filter: blur(8px);
                border-radius: 16px;
                border: 1px solid rgba(255, 255, 255, 0.3);
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .filter-section {
                background-color: white;
                padding: 24px;
                border-radius: 20px;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
                margin-bottom: 24px;
            }

            .content-card {
                border-radius: 20px;
                border: none;
                background: white;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            }

            .table thead th {
                background-color: #f8fafc;
                color: #64748b;
                font-weight: 600;
                font-size: 0.75rem;
                letter-spacing: 0.05em;
                padding: 16px;
                border-bottom: 1px solid #f1f5f9;
            }

            .table tbody td {
                padding: 16px;
                vertical-align: middle;
                border-bottom: 1px solid #f8fafc;
            }

            .badge-paid {
                background-color: #dcfce7;
                color: #15803d;
                font-weight: 600;
                padding: 6px 12px;
                border-radius: 50px;
                font-size: 0.85rem;
            }

            .btn-action {
                padding: 8px 16px;
                border-radius: 50px;
                font-weight: 600;
                font-size: 0.85rem;
                transition: 0.2s;
            }
    </style>
</head>

<body>

    <div class="container py-5 main-container">
        <d  iv class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <a href="/Staff/Dashboard" class="btn btn-white shadow-sm fw-bold d-inline-flex align-items-center px-3 py-2 mb-3 border" 
                style="border-radius: 12px; transition: all 0.3s ease; color: #475569; background: white;"
                onmouseover="this.style.backgroundColor='#6366f1'; this.style.color='white'; this.style.borderColor='#6366f1'; this.style.transform='translateY(-2px)';"
                onmouseout="this.style.backgroundColor='white'; this.style.color='#475569'; this.style.borderColor='#dee2e6'; this.style.transform='translateY(0)';"
                >
                    <i class="bi bi-house-door-fill me-2"></i>
                    กลับหน้าแดชบอร์ด
                </a>
                
                <div class="d-flex align-items-center gap-3">
                    <h2 class="fw-bold mb-0" style="color: #1e293b; letter-spacing: -1px;">ประวัติการขาย</h2>
                    <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary fw-bold px-3 py-2" style="font-size: 0.85rem; border: 1px solid rgba(99, 102, 241, 0.2);">
                        <i class="bi bi-receipt me-1"></i> @Model.Count() รายการ
                    </span>
                </div>
                <p class="text-muted small mb-0 mt-1">แสดงข้อมูลการสั่งซื้อและสรุปรายได้ทั้งหมด</p>
            </div>

            <div class="summary-card-custom px-4 py-3 position-relative text-white" style="min-width: 320px;">
                <div class="d-flex align-items-center position-relative" style="z-index: 2;">
                    <div class="icon-box me-3 shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="white" viewBox="0 0 16 16">
                            <path d="m3.494.013-.595.79A.747.747 0 0 0 3.333 2h9.334a.747.747 0 0 0 .434-1.197l-.595-.79a.2.2 0 0 0-.32 0L11.614 1h-7.228L3.814.013a.2.2 0 0 0-.32 0zM2.11 3.113A.5.5 0 0 1 2.5 3h11a.5.5 0 0 1 .39.813l-.547.73A.5.5 0 0 1 12.953 4.75H3.047a.5.5 0 0 1-.39-.207l-.547-.73a.5.5 0 0 1 0-.613zM14 5H2v7a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V5zm-1 7a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6h10v6z" />
                        </svg>
                    </div>
                    <div>   
                        <p class="mb-0 opacity-75 small fw-bold text-uppercase" style="letter-spacing: 0.5px;">ยอดขายรวม</p>
                        <h3 class="mb-0 fw-bold" style="font-size: 1.75rem;">฿@ViewBag.TotalSales?.ToString("N2")</h3>
                    </div>
                </div>
                <div class="position-absolute rounded-circle bg-white opacity-10" style="width: 120px; height: 120px; top: -50px; right: -40px;"></div>
            </div>
        </d>

            <div class="filter-section">
                <form asp-action="ManageOrders" method="get" class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">เลือกตามวันที่</label>
                        <input type="date" name="filterDate" class="form-control" value="@ViewBag.SelectedDate" style="border-radius: 12px;">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">ดูรายเดือน (ปีปัจจุบัน)</label>
                        <select name="filterMonth" class="form-select" style="border-radius: 12px;">
                            <option value="">-- แสดงทั้งหมด --</option>
                            @{
                                var months = new[] { "มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน",
                                                    "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม" };
                                for (int i = 1; i <= 12; i++)
                                {
                                    // เทียบค่า ViewBag.SelectedMonth เพื่อให้คงสถานะที่เลือกไว้
                                    bool isSelected = (ViewBag.SelectedMonth != null && (int)ViewBag.SelectedMonth == i);
                                    if (isSelected) {
                                        <option value="@i" selected>@months[i - 1]</option>
                                    } else {
                                        <option value="@i">@months[i - 1]</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100 fw-bold" style="border-radius: 12px;">
                            <i class="bi bi-filter me-1"></i> กรองข้อมูล
                        </button>
                        <a href="/Staff/ManageOrders" class="btn btn-light border fw-bold px-4" style="border-radius: 12px;">รีเซ็ต</a>
                    </div>
                </form>
            </div>

            <div class="card content-card overflow-hidden">
                <div class="table-responsive">
                    <table class="table mb-0 align-middle">
                        <thead>
                            <tr>
                                <th class="ps-4">หมายเลขบิล</th>
                                <th>วัน-เวลา</th>
                                <th>ยอดชำระ</th>
                                <th class="text-center">สถานะออเดอร์</th>
                                <th class="text-center">การชำระเงิน</th>
                                <th class="text-end pe-4">การจัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">#@item.OrderId</td>
                                    <td>
                                        <div class="fw-semibold">@item.OrderDate?.ToString("dd MMM yyyy")</div>
                                        <div class="text-muted small">@item.OrderDate?.ToString("HH:mm") น.</div>
                                    </td>
                                    <td class="fw-bold text-primary">฿@item.TotalPrice.ToString("N2")</td>
                                    <td class="text-center">
                                        @{
                                            var statusClass = item.OrderStatus switch {
                                                "Completed" => "background-color:#dcfce7;color:#15803d;",
                                                "Processing" => "background-color:#dbeafe;color:#1d4ed8;",
                                                "Pending" => "background-color:#fef3c7;color:#92400e;",
                                                "Cancelled" => "background-color:#fee2e2;color:#991b1b;",
                                                _ => "background-color:#f3f4f6;color:#374151;"
                                            };
                                        }
                                        @{
                                            var currentStatus = item.OrderStatus ?? "Pending";
                                        }
                                        @Html.Raw($@"<select class=""form-select form-select-sm"" style=""border-radius:50px;font-size:0.8rem;font-weight:600;min-width:130px;{statusClass}""
                                                onchange=""updateStatus({item.OrderId}, this.value)"">
                                            <option value=""Pending"" {(currentStatus == "Pending" ? "selected" : "")}>รอดำเนินการ</option>
                                            <option value=""Processing"" {(currentStatus == "Processing" ? "selected" : "")}>กำลังเตรียม</option>
                                            <option value=""Completed"" {(currentStatus == "Completed" ? "selected" : "")}>เสร็จสิ้น</option>
                                            <option value=""Cancelled"" {(currentStatus == "Cancelled" ? "selected" : "")}>ยกเลิก</option>
                                        </select>")
                                    </td>
                                    <td class="text-center">
                                        @{
                                            var payStatus = item.PaymentStatus ?? "Unpaid";
                                            var payClass = payStatus switch {
                                                "Paid" => "background-color:#dcfce7;color:#15803d;",
                                                "Unpaid" => "background-color:#fee2e2;color:#991b1b;",
                                                _ => "background-color:#f3f4f6;color:#374151;"
                                            };
                                        }
                                        @Html.Raw($@"<select class=""form-select form-select-sm"" style=""border-radius:50px;font-size:0.8rem;font-weight:600;min-width:130px;{payClass}""
                                                onchange=""verifyPayment({item.OrderId}, this.value)"">
                                            <option value=""Unpaid"" {(payStatus == "Unpaid" ? "selected" : "")}>ยังไม่ชำระ</option>
                                            <option value=""Paid"" {(payStatus == "Paid" ? "selected" : "")}>ชำระแล้ว</option>
                                        </select>")
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-2">
                                            <button class="btn btn-outline-primary btn-action"
                                                    onclick="showPopup(@item.OrderId)">รายละเอียด</button>
                                            <button class="btn btn-outline-danger btn-action"
                                                    onclick="deleteOrder(@item.OrderId)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            function showPopup(id) {
            fetch(`/Staff/GetOrderDetails/${id}`)
            .then(res => res.json())
            .then(data => {
            let rows = "";
            if (data && data.length > 0) {
            data.forEach(d => {
            rows += `
            <div class="row border-bottom py-2">
            <div class="col-6 text-start">${d.productName}</div>
            <div class="col-2 text-center">x${d.quantity}</div>
            <div class="col-4 text-end fw-bold">฿${d.price.toLocaleString()}</div>
            </div>`;
            });
            } else {
            rows = "<div class='py-4 text-muted text-center'>⚠️ ไม่มีรายละเอียดสินค้าในบิลนี้</div>";
            }
            Swal.fire({
            title: `รายละเอียดบิล #${id}`,
            html: `<div class="container-fluid" style="font-size: 0.9rem;">${rows}</div>`,
            confirmButtonText: 'ปิดหน้าต่าง',
            confirmButtonColor: '#6366f1',
            customClass: { popup: 'rounded-4' }
            });
            });
            }

            function updateStatus(id, status) {
                fetch(`/Staff/UpdateOrderStatus`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `id=${id}&status=${status}`
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({ icon: 'success', title: data.message, timer: 1500, showConfirmButton: false });
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        Swal.fire({ icon: 'error', title: data.message });
                    }
                });
            }

            function verifyPayment(id, paymentStatus) {
                fetch(`/Staff/VerifyPayment`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `id=${id}&paymentStatus=${paymentStatus}`
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({ icon: 'success', title: data.message, timer: 1500, showConfirmButton: false });
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        Swal.fire({ icon: 'error', title: data.message });
                    }
                });
            }

            function deleteOrder(id) {
            Swal.fire({
            title: 'ยืนยันการลบ?',
            text: `บิล #${id} จะถูกลบถาวร`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            confirmButtonText: 'ยืนยัน',
            cancelButtonText: 'ยกเลิก'
            }).then((result) => {
            if (result.isConfirmed) {
            fetch(`/Staff/DeleteOrder/${id}`, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
            if (data.success) { location.reload(); }
            });
            }
            });
            }
        </script>
    </body>

</html>